{
  "pewter_city_gym": {
    "name": "Pewter City Gym",
    "location_id": "pewter_city",
    "type_theme": "rock",
    "badge_reward": "boulder_badge",
    "tm_reward": "tm34",
    "gym_trainers": [
      "pewter_gym_camper_liam"
    ],
    "gym_leader": "leader_brock",
    "completed": false
  }
}

challengeGymLeader(gymId) {
  const gym = this.db.gyms[gymId];
  const minionsDefeated = gym.gym_trainers.every(tId => this.gameState.flags[`defeated_${tId}`]);

  if (!minionsDefeated) {
    this.ui.printToLog("You must defeat the Gym trainers before challenging the Gym Leader!");
    return;
  }

  const leaderData = this.db.trainers[gym.gym_leader];
  this.startTrainerBattle(leaderData.party[0], leaderData, "boulder_badge");
}
